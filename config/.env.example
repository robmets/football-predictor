# ============================================================
# Football Predictor — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to git!
# ============================================================

# --- football-data.org (free tier available) ---
# Get your key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_key_here

# --- OpenWeatherMap (free tier available) ---
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# --- The Odds API (freemium) ---
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=your_key_here

# --- Database ---
DB_PATH=data/football.db

# --- App Settings ---
LOG_LEVEL=INFO
DEFAULT_LEAGUE=BL1
SIMULATION_RUNS=10000
